{
  "xo": {
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-remark-retext/issues"
  },
  "main": "index.js",
  "name": "@stackline/remark-retext",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --conditions development test.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://github.com/alexandroit/stackline-remark-retext#readme",
  "keywords": [
    "unified",
    "remark",
    "remark-plugin",
    "retext",
    "plugin",
    "mdast",
    "markdown",
    "nlcst",
    "natural language",
    "prose",
    "stackline",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-remark-retext.git"
  },
  "description": "remark plugin to support retext",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    }
  ],
  "dependencies": {
    "unified": "^10.0.0",
    "@types/mdast": "^3.0.0",
    "@types/unist": "^2.0.0",
    "mdast-util-to-nlcst": "^5.0.0"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm"
    ]
  },
  "typeCoverage": {
    "#": "needed `any`s",
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true,
    "ignoreFiles": [
      "lib/index.d.ts",
      "lib/index.js"
    ]
  },
  "devDependencies": {
    "remark-parse": "^10.0.0",
    "remark-stringify": "^10.0.0",
    "retext-english": "^4.0.0",
    "retext-stringify": "^3.0.0",
    "tape": "5.10.2",
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "lib/index.d.ts",
    "lib/index.js",
    "license",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "overrides": {
    "tape": {
      "glob": "^13.0.6"
    }
  }
}
